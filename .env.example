# Read by docker-compose.yml for variable substitution (copy to .env).
# Everything here is optional: docker-compose.yml has local-only defaults.
# Set these to override them.
# JWT_SECRET=
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# POSTGRES_PASSWORD=
# CORS_ORIGIN=http://localhost:5173
# Host port for the backend container (change it if 3000 is taken by a local dev server).
# BACKEND_PORT=3000
# Shared secret the backend sends to the PDF service in X-Internal-Key (POST /render).
# PDF_SERVICE_KEY=
# Enables the PDF service queue consumer and /render. Use Azurite's documented
# development connection string, with endpoints http://azurite:10000/devstoreaccount1
# (Blob) and http://azurite:10001/devstoreaccount1 (Queue) from inside compose,
# or 127.0.0.1 from the host (pnpm --filter pdf-function demo).
# AZURE_STORAGE_CONNECTION_STRING=
# Parallel LibreOffice slots the PDF service uses for queue batches (default: CPUs - 1).
# WORKER_CONCURRENCY=
