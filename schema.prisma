// ============================================================================
// schema.prisma
// Generado a partir del modelo entidad-relación validado en Jira:
//   - SCRUM-21 / SCRUM-20 (HU05 - Modelo de datos conceptual)
//   - SCRUM-14 / SCRUM-13 (HU03 - Reglas de negocio)
//   - SCRUM-30 / SCRUM-44 (HU11 - Modelo de datos en Prisma)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Estados posibles de una Liquidación (HU03: ciclo de vida vigente/inactiva)
// ----------------------------------------------------------------------------
enum EstadoLiquidacion {
  VIGENTE
  INACTIVA
}

// ----------------------------------------------------------------------------
// Municipio
// ----------------------------------------------------------------------------
model Municipio {
  id            Int      @id @default(autoincrement())
  nombre        String
  departamento  String?
  codigoDane    String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  predios       Predio[]

  @@map("municipios")
}

// ----------------------------------------------------------------------------
// Predio
// ----------------------------------------------------------------------------
model Predio {
  id              Int      @id @default(autoincrement())
  codigoCatastral String   @unique
  direccion       String
  area            Decimal? @db.Decimal(12, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  municipioId     Int
  municipio       Municipio @relation(fields: [municipioId], references: [id])

  // Relación N:N con Propietario (copropiedad) vía tabla intermedia
  propietarios    PredioPropietario[]

  liquidaciones   Liquidacion[]

  @@index([municipioId])
  @@map("predios")
}

// ----------------------------------------------------------------------------
// Propietario
// ----------------------------------------------------------------------------
model Propietario {
  id           Int      @id @default(autoincrement())
  nombre       String
  documento    String   @unique // cédula / NIT
  telefono     String?
  email        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  predios      PredioPropietario[]

  @@map("propietarios")
}

// ----------------------------------------------------------------------------
// PredioPropietario (tabla intermedia N:N — copropiedad)
// Guarda además el porcentaje de propiedad de cada copropietario sobre el predio.
// ----------------------------------------------------------------------------
model PredioPropietario {
  predioId        Int
  propietarioId   Int
  porcentaje      Decimal  @db.Decimal(5, 2) // % de propiedad sobre el predio
  createdAt       DateTime @default(now())

  predio          Predio      @relation(fields: [predioId], references: [id], onDelete: Cascade)
  propietario     Propietario @relation(fields: [propietarioId], references: [id], onDelete: Cascade)

  @@id([predioId, propietarioId])
  @@map("predio_propietarios")
}

// ----------------------------------------------------------------------------
// Liquidacion
// HU03: única por predio+periodo, con estado vigente/inactiva.
// ----------------------------------------------------------------------------
model Liquidacion {
  id                Int               @id @default(autoincrement())
  periodo           String            // ej. "2026-01" (año-mes o año, según periodicidad definida)
  estado            EstadoLiquidacion @default(VIGENTE)
  fechaGeneracion   DateTime          @default(now())
  valorTotal        Decimal           @db.Decimal(14, 2)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  predioId          Int
  predio            Predio @relation(fields: [predioId], references: [id])

  detalles          DetalleLiquidacion[]
  mandamientos      Mandamiento[]

  // HU03: "Unicidad de liquidación por periodo" -> una liquidación vigente
  // por predio y periodo.
  @@unique([predioId, periodo])
  @@index([predioId])
  @@map("liquidaciones")
}

// ----------------------------------------------------------------------------
// DetalleLiquidacion
// ----------------------------------------------------------------------------
model DetalleLiquidacion {
  id             Int      @id @default(autoincrement())
  concepto       String
  valor          Decimal  @db.Decimal(14, 2)
  createdAt      DateTime @default(now())

  liquidacionId  Int
  liquidacion    Liquidacion @relation(fields: [liquidacionId], references: [id], onDelete: Cascade)

  @@index([liquidacionId])
  @@map("detalle_liquidaciones")
}

// ----------------------------------------------------------------------------
// Mandamiento
//
// NOTA (HU03 / SCRUM-13): la regla de qué ocurre con un mandamiento cuando
// su liquidación asociada es reemplazada quedó marcada como caso borde de
// alta complejidad, PENDIENTE de validación con el cliente. Por eso la
// relación se deja en modo restrictivo (onDelete: Restrict) para no perder
// ni reasignar mandamientos automáticamente hasta que esa regla se confirme.
// Ajustar esta relación cuando HU03 cierre ese punto.
// ----------------------------------------------------------------------------
model Mandamiento {
  id                Int      @id @default(autoincrement())
  numero            String   @unique
  fechaEmision      DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  liquidacionId     Int
  liquidacion       Liquidacion @relation(fields: [liquidacionId], references: [id], onDelete: Restrict)

  @@index([liquidacionId])
  @@map("mandamientos")
}
