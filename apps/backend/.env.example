DATABASE_URL="postgresql://postgres:postgres@localhost:5432/predial_dev"
# Local placeholder only. Outside a local machine (DATABASE_URL not on
# localhost) the backend refuses to start with a value published in the
# repository or shorter than 32 bytes; the same applies to PDF_SERVICE_KEY.
# Generate one per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="reemplazar-en-local"
# Set only by docker-compose.yml, whose database host is "db": marks that
# stack as local. Never set it in a deployed environment.
# ALLOW_DEV_CREDENTIALS=true
# Password for `admin:create` / `admin:rotate-password` (scripts/admin.ts),
# checked against the password policy. Leave unset to have a random one
# generated and printed once. Set it only in the terminal, not in this file.
# ADMIN_PASSWORD=
# Session times (security policy, section 2). Defaults: 15, 30 and 8.
# ACCESS_TOKEN_TTL_MINUTES=15
# SESSION_IDLE_TIMEOUT_MINUTES=30
# SESSION_MAX_HOURS=8
# Refresh token cookie. Defaults: SameSite=Strict, Secure, Path=/auth.
# "none" is only for a frontend on a different site than the API (always Secure).
# REFRESH_COOKIE_SAMESITE=strict
# "false" only where the API is still served over plain HTTP (not localhost).
# REFRESH_COOKIE_SECURE=true
# Browser-visible path of the /auth endpoints, if the API is published under a prefix.
# REFRESH_COOKIE_PATH=/auth
PORT=3000
CORS_ORIGIN="http://localhost:5173"
# Number of trusted proxy hops (for example, Application Gateway); unset to trust none.
# TRUST_PROXY_HOPS=1
# Swagger (/api/docs) is served unless this is "production".
# NODE_ENV=production

# --- docker compose (see docker-compose.yml) ---
# Inside the compose network the database host is "db" instead of localhost;
# docker-compose.yml already sets DATABASE_URL for its containers.

# --- PDF generation (apps/pdf-function; contract in Confluence, SL-118) ---
# The backend never renders: the individual PDF goes to POST /render and bulk
# jobs go through the Storage queues. Without these, PDF routes answer 503.
# Against Azurite, use its documented development connection string with
# endpoints http://localhost:10000 (Blob) and http://localhost:10001 (Queue);
# inside compose the host is "azurite" instead of localhost.
# AZURE_STORAGE_CONNECTION_STRING=
# PDF_SERVICE_URL="http://localhost:3001"
# Same value as the PDF service's PDF_SERVICE_KEY.
# PDF_SERVICE_KEY=
# Defaults: pdf-work, pdf-results, pdf-jobs, templates.
# PDF_WORK_QUEUE=pdf-work
# PDF_RESULTS_QUEUE=pdf-results
# PDF_JOBS_CONTAINER=pdf-jobs
# TEMPLATES_CONTAINER=templates
# Documents per batch, ZIP lifetime, watchdog and bulk limit. Defaults: 10, 60, 15, 10000.
# BATCH_SIZE=10
# ZIP_TTL_MINUTES=60
# JOB_WATCHDOG_MINUTES=15
# MAX_BULK_DOCUMENTS=10000

# --- Slompsim (assistant model) ---
# Unset ASSISTANT_PROVIDER (or no key) turns the assistant off: POST
# .../assistant/messages answers 503 ASSISTANT_UNAVAILABLE and the rest of the
# panel works. "anthropic" uses Claude through the Anthropic API; "fake"
# answers a fixed text without a key, to work on the panel. Changing provider
# only takes these variables.
# ASSISTANT_PROVIDER=anthropic
# Never commit a real key.
# ASSISTANT_API_KEY=
# Defaults: claude-haiku-5-5 and low (low | medium | high | xhigh | max).
# ASSISTANT_MODEL=claude-haiku-5-5
# ASSISTANT_EFFORT=low
# Only for a proxy or a compatible endpoint; the SDK's default otherwise.
# ASSISTANT_BASE_URL=
