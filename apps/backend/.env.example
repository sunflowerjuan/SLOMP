DATABASE_URL="postgresql://postgres:postgres@localhost:5432/predial_dev"
JWT_SECRET="reemplazar-en-local"
PORT=3000
# Parallel LibreOffice worker processes for bulk PDF generation (default: up to 6).
# BULK_PDF_WORKERS=4
CORS_ORIGIN="http://localhost:5173"
# Number of trusted proxy hops (for example, Application Gateway); unset to trust none.
# TRUST_PROXY_HOPS=1

# --- docker compose (see docker-compose.yml) ---
# Inside the compose network the database host is "db" instead of localhost;
# docker-compose.yml already sets DATABASE_URL for its containers.
# When set, PDF conversion goes to the PDF service (apps/pdf-function) instead
# of a local LibreOffice. Leave unset to use soffice installed on this machine.
# PDF_SERVICE_URL="http://pdf:3001"
# Requests in flight to the PDF service at once (default 2; keep it at or
# below the service's MAX_CONCURRENT_CONVERSIONS).
# PDF_SERVICE_CONCURRENCY=2
# Not read by the backend yet. Against the Azurite container, use its documented
# development connection string with endpoints http://azurite:10000 (Blob) and
# http://azurite:10001 (Queue).
# AZURE_STORAGE_CONNECTION_STRING=
