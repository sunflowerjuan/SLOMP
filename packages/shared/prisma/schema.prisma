// ============================================================================
// schema.prisma
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// Possible states of a Settlement -- the only 4 real states; "Inactiva"
// does NOT exist here: a replaced settlement doesn't change status,
// `replacedAt` below marks that instead. The Administrator can force any
// of these 4 manually.
// ----------------------------------------------------------------------------
enum SettlementStatus {
  VIGENTE
  PAGADA
  ACUERDO_DE_PAGO
  PRESCRITA
}

enum ResolutionKind {
  PRESCRIPTION_RISK
  NORMAL
}

// "Destino" column of the tax roll ("rural" / "urbano" in the source file).
enum LandUse {
  RURAL
  URBAN
}

// ----------------------------------------------------------------------------
// Owner document type (HU21 / SL-75), DIAN document types.
// Optional: only stored when the tax roll's CCNIT cell states it
// ("CC 40587912"); NULL otherwise. Never deduced from the number
// (apps/backend/src/tax-roll/parse-owner-document.ts).
// ----------------------------------------------------------------------------
enum DocumentType {
  RC // Registro civil
  TI // Tarjeta de identidad
  CC // Cédula de ciudadanía
  TE // Tarjeta de extranjería
  CE // Cédula de extranjería
  NIT // Número de identificación tributaria
  PA // Pasaporte
  TDE // Documento de identificación extranjero
  PEP // Permiso especial de permanencia
  PPT // Permiso por protección temporal
  NUIP // Número único de identificación personal
}

// ----------------------------------------------------------------------------
// Municipality
// ----------------------------------------------------------------------------
model Municipality {
  id        Int      @id @default(autoincrement())
  name      String
  state     String?
  daneCode  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties Property[]

  @@map("municipalities")
}

// ----------------------------------------------------------------------------
// Property
// ----------------------------------------------------------------------------
model Property {
  id             Int      @id @default(autoincrement())
  cadastralCode  String   @unique
  address        String
  ruralDistrict  String?
  neighborhood   String?
  latitude       Decimal? @db.Decimal(9, 6)
  longitude      Decimal? @db.Decimal(9, 6)
  area           Decimal? @db.Decimal(12, 2)
  landUse        LandUse? // "Destino" in the tax roll file; null if blank or unrecognized
  appraisalValue Decimal? @db.Decimal(14, 2) // "Avaluo" in the tax roll file
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  municipalityId Int
  municipality   Municipality @relation(fields: [municipalityId], references: [id])

  // N:N relationship with Owner (co-ownership) via join table
  owners PropertyOwner[]

  settlements Settlement[]
  resolutions Resolution[]

  @@index([municipalityId])
  @@map("properties")
}

// ----------------------------------------------------------------------------
// Owner
// ----------------------------------------------------------------------------
model Owner {
  id           Int           @id @default(autoincrement())
  name         String
  documentId   String        @unique // national ID / tax ID (cédula / NIT)
  // NULL = the tax roll didn't state it. No @default: never "CC by default".
  documentType DocumentType?
  phone        String?
  email        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  properties PropertyOwner[]

  @@map("owners")
}

// ----------------------------------------------------------------------------
// PropertyOwner (N:N join table — co-ownership)
// Also stores each co-owner's ownership percentage over the property.
// ----------------------------------------------------------------------------
model PropertyOwner {
  propertyId Int
  ownerId    Int
  percentage Decimal  @db.Decimal(5, 2) // % of ownership over the property
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  owner    Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@id([propertyId, ownerId])
  @@map("property_owners")
}

// ----------------------------------------------------------------------------
// Settlement
// Unique per property+period (app-level, see persist-tax-roll.ts). `status`
// is the real payment-lifecycle state and is never touched by the replace
// flow -- `replacedAt` is what marks a settlement as no longer the current
// one for its property+period. A full archive of replaced settlements is
// not implemented yet.
// ----------------------------------------------------------------------------
model Settlement {
  id          Int              @id @default(autoincrement())
  period      Int // Calendar year, e.g. 2026 (the tax roll only has annual periods)
  status      SettlementStatus @default(VIGENTE)
  replacedAt  DateTime? // Non-null once a newer import superseded this row
  issuedAt    DateTime         @default(now())
  totalAmount Decimal          @db.Decimal(14, 2)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id])

  resolutionId Int?
  resolution   Resolution? @relation(fields: [resolutionId], references: [id], onDelete: Restrict)

  details       SettlementDetail[]
  paymentOrders PaymentOrder[]

  @@index([propertyId, period])
  @@index([resolutionId])
  @@map("settlements")
}

// ----------------------------------------------------------------------------
// Resolution
// ----------------------------------------------------------------------------
model Resolution {
  id        Int              @id @default(autoincrement())
  number    String           @unique
  year      Int
  sequence  Int
  kind      ResolutionKind
  status    SettlementStatus @default(VIGENTE)
  issuedAt  DateTime         @default(now())
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id])

  settlements Settlement[]

  @@unique([year, sequence])
  @@index([propertyId])
  @@map("resolutions")
}

// ----------------------------------------------------------------------------
// ResolutionCounter
// ----------------------------------------------------------------------------
model ResolutionCounter {
  year         Int @id
  lastSequence Int @default(0)

  @@map("resolution_counters")
}

// ----------------------------------------------------------------------------
// SettlementDetail
// ----------------------------------------------------------------------------
model SettlementDetail {
  id        Int      @id @default(autoincrement())
  concept   String
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())

  settlementId Int
  settlement   Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@index([settlementId])
  @@map("settlement_details")
}

// ----------------------------------------------------------------------------
// PaymentOrder
//
// NOTE: the rule for what happens to a payment order when its associated
// settlement is replaced was flagged as a high-complexity edge case,
// PENDING validation with the client. That's why the relation is left in
// restrictive mode (onDelete: Restrict), so payment orders are not lost or
// automatically reassigned until that rule is confirmed.
// ----------------------------------------------------------------------------
model PaymentOrder {
  id       Int      @id @default(autoincrement())
  number   String   @unique
  issuedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settlementId Int
  settlement   Settlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)

  @@index([settlementId])
  @@map("payment_orders")
}

// ----------------------------------------------------------------------------
// Administrator
// Login credentials for the Panel Administrador. A single role for now —
// no per-admin permissions/roles yet.
// ----------------------------------------------------------------------------
model Administrator {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  taxRollImports TaxRollImport[]

  @@map("administrators")
}

// ----------------------------------------------------------------------------
// TaxRollImport
// One row per POST /tax-roll/import call (upload history). Each call is a
// full import attempt, whether or not the caller later confirms replacing
// the conflicts it reports.
// ----------------------------------------------------------------------------
model TaxRollImport {
  id         Int      @id @default(autoincrement())
  fileName   String
  importedAt DateTime @default(now())

  // Counts from ParseTaxRollExcelResult / PersistTaxRollResult — see
  // apps/backend/src/tax-roll/tax-roll-row.dto.ts and persist-tax-roll.ts.
  validRows      Int
  invalidRows    Int
  warnings       Int
  properties     Int
  owners         Int
  settlements    Int
  conflicts      Int

  // Nullable so the row survives if the Administrator account is later
  // deleted — the history entry is still meaningful without it.
  administratorId Int?
  administrator   Administrator? @relation(fields: [administratorId], references: [id], onDelete: SetNull)

  @@index([importedAt])
  @@map("tax_roll_imports")
}
