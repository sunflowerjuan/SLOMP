// ============================================================================
// schema.prisma
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// Possible states of a Settlement. "Inactiva" does NOT exist here: a
// replaced settlement doesn't change status, `replacedAt` below marks that
// instead. EN_FIRME is set automatically 60 days after the resolution is
// issued (en-firme.service.ts); which manual changes are allowed lives in
// settlement-status-rules.ts. PRESCRITA is shown as "Pérdida temporal de
// competencia" in the frontend.
// ----------------------------------------------------------------------------
enum SettlementStatus {
  VIGENTE
  EN_FIRME
  PAGADA
  ACUERDO_DE_PAGO
  PRESCRITA
}

enum ResolutionKind {
  PRESCRIPTION_RISK
  NORMAL
}

// "Destino" column of the tax roll ("rural" / "urbano" in the source file).
enum LandUse {
  RURAL
  URBAN
}

// ----------------------------------------------------------------------------
// Owner document type (HU21 / SL-75), DIAN document types.
// Optional: only stored when the tax roll's CCNIT cell states it
// ("CC 40587912"); NULL otherwise. Never deduced from the number
// (apps/backend/src/tax-roll/parse-owner-document.ts).
// ----------------------------------------------------------------------------
enum DocumentType {
  RC // Registro civil
  TI // Tarjeta de identidad
  CC // Cédula de ciudadanía
  TE // Tarjeta de extranjería
  CE // Cédula de extranjería
  NIT // Número de identificación tributaria
  PA // Pasaporte
  TDE // Documento de identificación extranjero
  PEP // Permiso especial de permanencia
  PPT // Permiso por protección temporal
  NUIP // Número único de identificación personal
}

// ----------------------------------------------------------------------------
// Municipality
// ----------------------------------------------------------------------------
model Municipality {
  id        Int      @id @default(autoincrement())
  name      String
  state     String
  // 5-digit DANE code; the first 5 digits of every cadastral code of the
  // municipality (validated on tax roll upload).
  daneCode  String   @unique
  // Lowercase URL identifier, e.g. "paez" -- part of /municipalities/:slug/...
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties         Property[]
  owners             Owner[]
  resolutions        Resolution[]
  resolutionCounters ResolutionCounter[]
  taxRollImports     TaxRollImport[]
  pdfJobs            PdfJob[]
  templates          Template[]

  @@map("municipalities")
}

// ----------------------------------------------------------------------------
// Property
// ----------------------------------------------------------------------------
model Property {
  id             Int      @id @default(autoincrement())
  cadastralCode  String   @unique
  address        String
  ruralDistrict  String?
  neighborhood   String?
  latitude       Decimal? @db.Decimal(9, 6)
  longitude      Decimal? @db.Decimal(9, 6)
  area           Decimal? @db.Decimal(12, 2)
  landUse        LandUse? // "Destino" in the tax roll file; null if blank or unrecognized
  appraisalValue Decimal? @db.Decimal(14, 2) // "Avaluo" in the tax roll file
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  municipalityId Int
  municipality   Municipality @relation(fields: [municipalityId], references: [id])

  // N:N relationship with Owner (co-ownership) via join table
  owners PropertyOwner[]

  settlements Settlement[]
  resolutions Resolution[]

  @@index([municipalityId])
  @@map("properties")
}

// ----------------------------------------------------------------------------
// Owner
// ----------------------------------------------------------------------------
model Owner {
  id           Int           @id @default(autoincrement())
  name         String
  documentId   String // national ID / tax ID (cédula / NIT); unique per municipality
  // NULL = the tax roll didn't state it. No @default: never "CC by default".
  documentType DocumentType?
  phone        String?
  email        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  municipalityId Int
  municipality   Municipality @relation(fields: [municipalityId], references: [id])

  properties PropertyOwner[]

  @@unique([municipalityId, documentId])
  @@map("owners")
}

// ----------------------------------------------------------------------------
// PropertyOwner (N:N join table — co-ownership)
// Also stores each co-owner's ownership percentage over the property.
// ----------------------------------------------------------------------------
model PropertyOwner {
  propertyId Int
  ownerId    Int
  percentage Decimal  @db.Decimal(5, 2) // % of ownership over the property
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  owner    Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@id([propertyId, ownerId])
  @@map("property_owners")
}

// ----------------------------------------------------------------------------
// Settlement
// Unique per property+period (app-level, see persist-tax-roll.ts). `status`
// is the real payment-lifecycle state and is never touched by the replace
// flow -- `replacedAt` is what marks a settlement as no longer the current
// one for its property+period. A full archive of replaced settlements is
// not implemented yet.
// ----------------------------------------------------------------------------
model Settlement {
  id          Int              @id @default(autoincrement())
  period      Int // Calendar year, e.g. 2026 (the tax roll only has annual periods)
  status      SettlementStatus @default(VIGENTE)
  replacedAt  DateTime? // Non-null once a newer import superseded this row
  issuedAt    DateTime         @default(now())
  totalAmount Decimal          @db.Decimal(14, 2)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id])

  resolutionId Int?
  resolution   Resolution? @relation(fields: [resolutionId], references: [id], onDelete: Restrict)

  details       SettlementDetail[]
  paymentOrders PaymentOrder[]

  @@index([propertyId, period])
  @@index([resolutionId])
  @@map("settlements")
}

// ----------------------------------------------------------------------------
// Resolution
// ----------------------------------------------------------------------------
model Resolution {
  id        Int              @id @default(autoincrement())
  number    String
  year      Int
  sequence  Int
  kind      ResolutionKind
  status    SettlementStatus @default(VIGENTE)
  issuedAt  DateTime         @default(now())
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id])

  municipalityId Int
  municipality   Municipality @relation(fields: [municipalityId], references: [id])

  // Bulk job that issued it; reverting a failed job deletes exactly these.
  pdfJobId String?
  pdfJob   PdfJob? @relation(fields: [pdfJobId], references: [id], onDelete: SetNull)

  settlements Settlement[]

  // The consecutive restarts per municipality: 2026-0001 exists in each one.
  @@unique([municipalityId, number])
  @@unique([municipalityId, year, sequence])
  @@index([pdfJobId])
  @@index([propertyId])
  @@map("resolutions")
}

// ----------------------------------------------------------------------------
// ResolutionCounter
// ----------------------------------------------------------------------------
model ResolutionCounter {
  municipalityId Int
  municipality   Municipality @relation(fields: [municipalityId], references: [id])
  year           Int
  lastSequence   Int          @default(0)

  @@id([municipalityId, year])
  @@map("resolution_counters")
}

// ----------------------------------------------------------------------------
// SettlementDetail
// ----------------------------------------------------------------------------
model SettlementDetail {
  id        Int      @id @default(autoincrement())
  concept   String
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())

  settlementId Int
  settlement   Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@index([settlementId])
  @@map("settlement_details")
}

// ----------------------------------------------------------------------------
// PaymentOrder
//
// NOTE: the rule for what happens to a payment order when its associated
// settlement is replaced was flagged as a high-complexity edge case,
// PENDING validation with the client. That's why the relation is left in
// restrictive mode (onDelete: Restrict), so payment orders are not lost or
// automatically reassigned until that rule is confirmed.
// ----------------------------------------------------------------------------
model PaymentOrder {
  id       Int      @id @default(autoincrement())
  number   String   @unique
  issuedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settlementId Int
  settlement   Settlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)

  @@index([settlementId])
  @@map("payment_orders")
}

// ----------------------------------------------------------------------------
// Administrator
// Login credentials for the Panel Administrador. A single role for now —
// no per-admin permissions/roles yet.
// ----------------------------------------------------------------------------
model Administrator {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  taxRollImports TaxRollImport[]
  refreshTokens  RefreshToken[]
  pdfJobs        PdfJob[]
  templates      Template[]

  @@map("administrators")
}

// ----------------------------------------------------------------------------
// RefreshToken
// One row per refresh token issued to an Administrator (security policy,
// section 2). Only the SHA-256 hash is stored, never the token. Every
// rotation revokes the row and adds a new one with the same `familyId`, so a
// family is one login session; a family with no live row is a closed session.
// ----------------------------------------------------------------------------
model RefreshToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  familyId  String
  createdAt DateTime @default(now())

  // Idle limit: moves forward with every rotation.
  expiresAt DateTime
  // Absolute limit of the session, fixed at login and copied on rotation.
  sessionExpiresAt DateTime
  // Set when the token is rotated, on logout, or when reuse is detected.
  revokedAt DateTime?

  administratorId Int
  administrator   Administrator @relation(fields: [administratorId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([administratorId])
  @@map("refresh_tokens")
}

// ----------------------------------------------------------------------------
// TaxRollImport
// One row per POST /tax-roll/import call (upload history). Each call is a
// full import attempt, whether or not the caller later confirms replacing
// the conflicts it reports.
// ----------------------------------------------------------------------------
model TaxRollImport {
  id         Int      @id @default(autoincrement())
  fileName   String
  importedAt DateTime @default(now())

  // Counts from ParseTaxRollExcelResult / PersistTaxRollResult — see
  // apps/backend/src/tax-roll/tax-roll-row.dto.ts and persist-tax-roll.ts.
  validRows      Int
  invalidRows    Int
  warnings       Int
  properties     Int
  owners         Int
  settlements    Int
  conflicts      Int

  // Nullable so the row survives if the Administrator account is later
  // deleted — the history entry is still meaningful without it.
  administratorId Int?
  administrator   Administrator? @relation(fields: [administratorId], references: [id], onDelete: SetNull)

  municipalityId Int
  municipality   Municipality @relation(fields: [municipalityId], references: [id])

  @@index([municipalityId, importedAt])
  @@map("tax_roll_imports")
}

// ----------------------------------------------------------------------------
// Bulk PDF generation (SL-120, contract in Confluence "Servicio de PDF:
// contrato entre backend y worker (SL-118)"). The backend coordinates; the
// PDF service renders through the pdf-work / pdf-results queues.
// ----------------------------------------------------------------------------
enum PdfJobStatus {
  PREPARING
  RUNNING
  ASSEMBLING
  DONE
  FAILED
  EXPIRED
}

enum PdfDocumentType {
  LIQUIDACION
  MANDAMIENTO
}

enum PdfBatchStatus {
  PENDING
  DONE
  FAILED
}

// Kept as history once finished. At most one PREPARING/RUNNING/ASSEMBLING job
// per municipality: partial unique index created by hand in the migration.
model PdfJob {
  id                 String          @id @default(uuid())
  documentType       PdfDocumentType
  // Only for liquidations: which ZIP (prescription risk or normal collection).
  kind               ResolutionKind?
  status             PdfJobStatus    @default(PREPARING)
  totalDocuments     Int
  completedDocuments Int             @default(0)
  totalBatches       Int             @default(0)
  templateBlob       String
  templateSha256     String
  year               Int
  // Consecutive range reserved for new resolutions; null when the job only
  // re-renders resolutions issued before.
  firstSequence      Int?
  lastSequence       Int?
  errorCode          String?
  errorDetails       Json?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  startedAt          DateTime?
  finishedAt         DateTime?
  expiresAt          DateTime?

  municipalityId Int
  municipality   Municipality @relation(fields: [municipalityId], references: [id])

  createdById Int?
  createdBy   Administrator? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  batches     PdfJobBatch[]
  resolutions Resolution[]

  @@index([municipalityId, createdAt])
  @@index([status])
  @@map("pdf_jobs")
}

// Progress of each batch while the job runs; deleted when it finishes.
model PdfJobBatch {
  jobId         String
  job           PdfJob         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  batchIndex    Int
  status        PdfBatchStatus @default(PENDING)
  documentCount Int
  attempts      Int            @default(0)
  errorCode     String?
  updatedAt     DateTime       @updatedAt

  @@id([jobId, batchIndex])
  @@map("pdf_job_batches")
}

// ----------------------------------------------------------------------------
// Template
// One row per uploaded .docx version of a municipality's document template.
// Only valid templates are stored. At most one version per municipality and
// document type is active: partial unique index created by hand in the
// migration. The file lives in Blob at `blobPath` ("<container>/<slug>/
// <type>/<version>.docx"); older versions are kept so one can be reactivated.
// ----------------------------------------------------------------------------
model Template {
  id           Int             @id @default(autoincrement())
  documentType PdfDocumentType
  version      Int
  blobPath     String
  // Hash of the file: travels with the blob path in every PDF message.
  sha256       String
  fileName     String
  // The {markers} found in the file, as validated against the field catalog.
  fields       String[]
  isActive     Boolean         @default(false)
  createdAt    DateTime        @default(now())

  municipalityId Int
  municipality   Municipality @relation(fields: [municipalityId], references: [id])

  uploadedById Int?
  uploadedBy   Administrator? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@unique([municipalityId, documentType, version])
  @@map("templates")
}
