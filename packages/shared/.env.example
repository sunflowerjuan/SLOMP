DATABASE_URL="postgresql://postgres:postgres@localhost:5432/predial_dev"

# Seeded Panel Administrador account (db:seed). Optional on a local database
# (DATABASE_URL on localhost), where it falls back to this dev-only default.
# On any other database both are required, the password must pass the
# password policy (12+ characters, not a common password) and the seed
# never prints it (SL-115).
SEED_ADMIN_EMAIL="admin@paez-boyaca.gov.co"
SEED_ADMIN_PASSWORD="changeme123"

# Password for `admin:create` / `admin:rotate-password`, checked against the
# same policy. Leave unset to have a random one generated and printed once.
# ADMIN_PASSWORD=
