# Variables of docker-compose.prod.yml. Copy to .env.prod on the VPS only,
# fill it in and restrict it: never commit .env.prod.
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
# Every secret is new for production (never reuse a development value).
# Generate each one with:
#   openssl rand -hex 32

# Public domain; its DNS A record must point to the VPS. Caddy issues the
# certificate for it and for www.<domain>.
DOMAIN=
POSTGRES_PASSWORD=
JWT_SECRET=
# Shared secret between the backend and the PDF service.
PDF_SERVICE_KEY=

# Slompsim's model. Leave ASSISTANT_PROVIDER empty to keep the assistant off.
# The key is created in the Anthropic account that pays for the API (prepaid
# credit without auto-reload caps the spending). Never commit it.
ASSISTANT_PROVIDER=anthropic
ASSISTANT_API_KEY=
# Optional. Defaults: claude-haiku-5-5 and low.
ASSISTANT_MODEL=
ASSISTANT_EFFORT=
